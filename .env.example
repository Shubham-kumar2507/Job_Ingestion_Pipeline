# SQLite database used by the local pipeline.
DATABASE_URL=sqlite:///job_listings.db

# Opt-in fallback only. Calls are capped and occur solely after validation fails.
LLM_FALLBACK_ENABLED=false
GROQ_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MAX_CALLS=5

# Demo only: adds one intentionally malformed record after parsing so the
# validation-failure → Groq fallback path is visible. Keep false in normal runs.
DEMO_INJECT_INVALID_RECORD=false
