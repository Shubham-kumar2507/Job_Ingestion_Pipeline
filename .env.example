# SQLite is convenient locally. Use a PostgreSQL DATABASE_URL for Vercel/GitHub Actions.
DATABASE_URL=sqlite:///job_listings.db

# LLM repair only runs when a source record fails validation; calls are capped per run.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MAX_CALLS=5

# Demo only: inject one invalid fixture to test the fallback. It is not stored.
DEMO_INJECT_INVALID_RECORD=false
